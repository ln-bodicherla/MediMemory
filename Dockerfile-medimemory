# MediMemory Dockerfile - Medical Image Analysis
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies for medical image processing
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements-medimemory.txt .
RUN pip install --no-cache-dir -r requirements-medimemory.txt

# Copy application code
COPY . .

# Create directories for medical data
RUN mkdir -p /app/data /app/medical_images /app/models

# Set environment variables
ENV PYTHONPATH=/app
ENV MEDIMEMORY_DB_PATH=/app/data/medimemory.db
ENV MEDIMEMORY_HOST=0.0.0.0
ENV MEDIMEMORY_PORT=8001

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run the MediMemory server
CMD ["python", "medimemory_server.py"]
